# Cowpanion vhost logs: the protocol's privacy rules cap IP retention at 7 days.
# Installed to /etc/logrotate.d/apache-cows. Lives in its own directory so it does
# not collide with Debian's /etc/logrotate.d/apache2 glob (/var/log/apache2/*.log).
#
# daily + rotate 6 = the live file (< 1 day) plus six dated files = 7 days maximum.
# maxage 7 removes anything older even if rotation was skipped for a while.
/var/log/apache2/cows/*.log {
    daily
    rotate 6
    maxage 7
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 640 root adm
    sharedscripts
    postrotate
        if invoke-rc.d apache2 status > /dev/null 2>&1; then
            invoke-rc.d apache2 reload > /dev/null 2>&1
        fi
    endscript
}
