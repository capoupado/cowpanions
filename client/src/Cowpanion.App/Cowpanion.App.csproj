<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: the WinForms analyzer wants DPI mode set in code, but this is a WPF app and WPF takes PerMonitorV2
         from the manifest (plan P-1). WinForms is only used for Screen/NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Cowpanion</AssemblyName>
    <RootNamespace>Cowpanion.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- EmojiRasterizer copies WIC pixels through a fixed pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Release version; client/release.ps1 overrides it with -p:Version. Velopack reads the packed version, this one
         labels dev builds. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main owns startup so VelopackApp.Run() is the first code that runs (Velopack requirement). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cowpanion.Core\Cowpanion.Core.csproj" />
    <ProjectReference Include="..\Cowpanion.Net\Cowpanion.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer + self-update (Updates/UpdateService.cs). Feed on our own domain, see docs/DECISIONS.md. -->
    <PackageReference Include="Velopack" Version="1.2.158" />
    <!-- Direct2D/DirectWrite for colour emoji (EmojiRasterizer): WPF's text stack cannot draw COLR/CPAL fonts. -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <!-- Sprite pack: linked from client/assets (single source of truth), copied to output as assets/sprites/cow/. -->
  <ItemGroup>
    <None Include="..\..\assets\sprites\cow\**" Link="assets\sprites\cow\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is used only for Screen and NotifyIcon; keep its namespace out of implicit usings so WPF types win. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
