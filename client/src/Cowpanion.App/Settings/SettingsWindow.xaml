<Window x:Class="Cowpanion.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cowpanion — settings"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Hyperlink Click="OnOpenConfigFile">Open config.json</Hyperlink>
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="Apply" Width="80" Click="OnApply" />
                <Button DockPanel.Dock="Right" Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button DockPanel.Dock="Right" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            </DockPanel>
        </StackPanel>

        <TabControl MinHeight="470">
            <TabItem Header="General">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Your name" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="DisplayNameBox" MaxLength="16" Margin="0,4" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Cow colour" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="VariantBox" Margin="0,4" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Sleep after idle (minutes)" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="SleepBox" Width="80" HorizontalAlignment="Left" Margin="0,4" />
                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="StartWithWindowsBox" Content="Start with Windows" />
                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="PauseOnFullscreenBox" Content="Hide the cows while a full-screen app or presentation is running" />
                    <CheckBox Grid.Row="5" Grid.ColumnSpan="2" x:Name="MooBox" Content="Moo sound (no sound file ships yet, so this is silent)" />
                </Grid>
            </TabItem>

            <TabItem Header="Pasture">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="MultiplayerBox" Content="Multiplayer (join a pasture with friends)" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Pasture code" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PastureBox" MaxLength="32" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Text="Letters, digits and dashes. Everyone who types the same code shares a pasture; 'commons' is the public one." />
                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="BubblesEnabledBox" Content="Show speech bubbles and reactions" />
                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="BubblesMutedBox" Content="Mute bubbles for now (the mute hotkey toggles this)" />
                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Offline herd size" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="HerdSizeBox" Width="80" Margin="0,4" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" Text="0–12, your own cow included" />
                    </StackPanel>
                    <Expander Grid.Row="6" Grid.ColumnSpan="2" Header="Advanced" Margin="0,8,0,0">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Server URL" />
                            <TextBox Grid.Column="1" x:Name="ServerUrlBox" Margin="0,4" />
                        </Grid>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Display">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Cow size" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ScaleBox" Width="120" HorizontalAlignment="Left" Margin="0,4" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Monitors" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MonitorsBox" Width="200" HorizontalAlignment="Left" Margin="0,4" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Frame rate while moving" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ActiveFpsBox" Width="80" HorizontalAlignment="Left" Margin="0,4" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Frame rate while still" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="IdleFpsBox" Width="80" HorizontalAlignment="Left" Margin="0,4" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Sprite pack" />
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="SpritePackBox" Width="200" HorizontalAlignment="Left" Margin="0,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}" Text="Frame rates: 5–60 while moving, 1 up to that while still. A new sprite pack takes effect on the next start." />
                </Grid>
            </TabItem>

            <TabItem Header="Hotkeys">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Click a box and press the new combination. Backspace unbinds it; Esc keeps the old one. While a box has focus every Cowpanion hotkey is switched off, Quit included, so the combination reaches the box." />
                    <Grid x:Name="HotkeyGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <Button Content="Restore default hotkeys" HorizontalAlignment="Left" Padding="10,2" Margin="0,10,0,0" Click="OnRestoreHotkeys" />
                    <CheckBox x:Name="FocusModeBox" Margin="0,14,0,0" Content="Focus mode" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="In focus mode Cowpanion releases every hotkey except Quit and the focus-mode toggle, so no other key combination is claimed. It lasts until you turn it off (here, in the tray menu, or with its own hotkey). Cowpanion never reads other keystrokes, focus mode or not." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
