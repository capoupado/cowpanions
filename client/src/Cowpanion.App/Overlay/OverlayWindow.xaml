<Window x:Class="Cowpanion.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cowpanion"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor">
    <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="HerdCanvas" IsHitTestVisible="False" />
        <Canvas x:Name="BubbleCanvas" IsHitTestVisible="False" />

        <!-- "+N" overflow indicator: members beyond the server's visible cap. -->
        <Border x:Name="OverflowBadge" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,6"
                Background="#B0FFFFFF" BorderBrush="#80403020" BorderThickness="1" CornerRadius="9" Padding="7,2">
            <TextBlock x:Name="OverflowText" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#5A3A1A" Text="+0" />
        </Border>

        <!-- Interaction-mode indicator: visible only while chat mode is armed. -->
        <Border x:Name="ModeIndicator" Visibility="Collapsed" IsHitTestVisible="False"
                VerticalAlignment="Bottom" Height="3" Background="#CCFFB000" />
        <Border x:Name="ModeLabel" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8"
                Background="#E0FFB000" CornerRadius="6" Padding="8,3">
            <TextBlock FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#402800"
                       Text="Chat mode - Enter sends, Esc cancels, auto-closes after 8 s idle" />
        </Border>

        <!-- Chat input, positioned near the user's own cow while armed. -->
        <Canvas x:Name="ChatCanvas">
            <Border x:Name="ChatPanel" Visibility="Collapsed"
                    Background="#F4FFFFFF" BorderBrush="#CC7A5A3A" BorderThickness="1.5" CornerRadius="8" Padding="6"
                    Width="300">
                <TextBox x:Name="ChatBox" MaxLength="140" FontFamily="Segoe UI, Segoe UI Emoji" FontSize="13"
                         BorderThickness="0" Background="Transparent" Foreground="#221E1A"
                         AcceptsReturn="False" />
            </Border>
        </Canvas>
    </Grid>
</Window>
