<Project Sdk="Microsoft.NET.Sdk">

  <!-- P0 feasibility spike. Console OutputType on purpose so CPU samples print to the terminal. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: the WinForms analyzer wants DPI mode set in code, but this is a WPF app and WPF takes PerMonitorV2
         from the manifest (plan P-1). WinForms is only used for Screen/NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>Cowpanion.Spike</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used only for Screen and NotifyIcon; keep its namespace out of implicit usings so WPF types win. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
